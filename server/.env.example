# PostgreSQL connection supplied by Railway or another provider.
DATABASE_URL=

# Local PostgreSQL normally uses false.
# Managed production PostgreSQL commonly requires true.
DATABASE_SSL=false

# Keep true when the provider supplies a publicly trusted certificate.
# Change to false only when the provider explicitly requires it.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Private key required to download the Level 5 CSV report.
# Use a long random value in production. Do not commit the real key.
EXPORT_API_KEY=

# Local development environment.
# Railway production variables must be configured in its dashboard.

NODE_ENV=development
PORT=3001

# Separate multiple allowed frontend origins with commas.
# Railway production should include the deployed Vercel URL.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,https://stellar-chapter-pay.vercel.app

STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

CHAPTER_PAYMENT_CONTRACT_ID=CD4Q4QQRSLMXOZCUE72OAXLKA5XBGAEO4G4O37BF4QIMOY7GQUHTAE2O
CHAPTER_TOKEN_CONTRACT_ID=CD4IL6YDYQRRLH5RKJCQ2D4XGQWJSLSOKBTGL6UE6VLBBL4I4EWEXTNR

# PostgreSQL connection supplied by Railway or another provider.
# Memory storage is used locally when DATABASE_URL is empty.
DATABASE_URL=

# Local PostgreSQL normally uses false.
# Follow the database provider's SSL requirements in production.
DATABASE_SSL=false

# Keep true when the provider supplies a publicly trusted certificate.
# Change only when the provider explicitly requires another value.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
